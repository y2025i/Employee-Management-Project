from nicegui import ui


class EmployeeApp:
    def __init__(self) -> None:
        self.build_ui()

    def build_ui(self) -> None:
        ui.query('body').style('margin: 0; background-color: #F5F7F7;')

        with ui.column().classes('w-full gap-0'):

            # HEADER
            with ui.row().classes('w-full justify-center mt-3'):
                ui.label('Employee Management System') \
                    .classes('text-white text-4xl font-bold p-4 text-center w-[95%]') \
                    .style('background-color: #6CA6A6; border-radius: 15px;')

            with ui.row().classes('w-full items-start no-wrap').style('padding: 12px; gap: 16px;'):

                # EMPLOYEE DETAILS
                with ui.card().classes('shadow-2 w-[350px]').style('background-color: #EAF2F2; min-height: 560px;'):
                    ui.label('Employee Details') \
                        .classes('text-2xl font-bold mb-3 text-gray-800')

                    self.employee_id = ui.input("Employee's ID").classes('w-full mb-2')
                    self.name = ui.input('Full Name').classes('w-full mb-2')
                    self.address = ui.input('Address').classes('w-full mb-2')
                    self.department = ui.input('Department').classes('w-full mb-2')
                    self.position = ui.input('Position').classes('w-full mb-2')
                    self.salary = ui.input('Salary').classes('w-full mb-2')

                    with ui.row().classes('w-full gap-2 mt-4'):
                        ui.button('Add', on_click=self.add_employee).props('color=green').classes('flex-1')
                        ui.button('Update').props('color=blue').classes('flex-1')

                    with ui.row().classes('w-full gap-2 mt-2'):
                        ui.button('Delete').props('color=red').classes('flex-1')
                        ui.button('Clear', on_click=self.clear_form).props('color=grey').classes('flex-1')

                # EMPLOYEE RECORDS
                with ui.card().classes('shadow-2 flex-1').style('background-color: #EAF2F2; min-height: 560px;'):
                    ui.label('Employee Records') \
                        .classes('text-2xl font-bold mb-3 text-gray-800')

                    with ui.row().classes('w-full bg-white p-3 rounded items-center gap-3 mb-4'):
                        self.search_input = ui.input('Search value').classes('flex-1')
                        self.search_type = ui.select(
                            ['ID', 'Name'],
                            value='ID',
                            label='Search by'
                        ).classes('w-40')

                        ui.button('Search', on_click=self.search_employee).props('color=blue')
                        ui.button('Show All', on_click=self.show_all_employees).props('color=grey')

                    columns = [
                        {'name': 'id', 'label': 'ID', 'field': 'id'},
                        {'name': 'name', 'label': 'Name', 'field': 'name'},
                        {'name': 'address', 'label': 'Address', 'field': 'address'},
                        {'name': 'department', 'label': 'Department', 'field': 'department'},
                        {'name': 'position', 'label': 'Position', 'field': 'position'},
                        {'name': 'salary', 'label': 'Salary', 'field': 'salary'},
                    ]

                    self.rows = []
                    self.table = ui.table(
                        columns=columns,
                        rows=self.rows,
                        row_key='id',
                    ).classes('w-full bg-white')

    def add_employee(self) -> None:
        if not self.employee_id.value or not self.name.value:
            ui.notify('ID i ime su obavezni!', color='red')
            return

        self.rows.append({
            'id': self.employee_id.value,
            'name': self.name.value,
            'address': self.address.value,
            'department': self.department.value,
            'position': self.position.value,
            'salary': self.salary.value,
        })

        self.show_all_employees()
        ui.notify('Zaposleni uspješno dodat!', color='green')
        self.clear_form()

    def search_employee(self) -> None:
        search_value = self.search_input.value

        if not search_value:
            ui.notify('Unesi vrijednost za pretragu!', color='red')
            return

        if self.search_type.value == 'ID':
            result = [
                emp for emp in self.rows
                if str(emp['id']) == str(search_value)
            ]
        else:
            result = [
                emp for emp in self.rows
                if search_value.lower() in emp['name'].lower()
            ]

        self.table.rows = result
        self.table.update()

        if result:
            ui.notify('Rezultat pronađen.', color='green')
        else:
            ui.notify('Nema rezultata.', color='orange')

    def show_all_employees(self) -> None:
        self.table.rows = self.rows
        self.table.update()

    def clear_form(self) -> None:
        self.employee_id.value = ''
        self.name.value = ''
        self.address.value = ''
        self.department.value = ''
        self.position.value = ''
        self.salary.value = ''


app = EmployeeApp()
ui.run(title='Employee Management System')
